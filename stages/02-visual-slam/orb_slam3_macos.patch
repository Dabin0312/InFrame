+void System::SaveMapPointsXYZ(const string &filename)
+{
+    ofstream f(filename.c_str());
+    f << "# id x_slam y_slam z_slam\n";
+    vector<MapPoint*> points = mpAtlas->GetAllMapPoints();
+    for(MapPoint* point : points)
+    {
+        if(point == nullptr || point->isBad())
+            continue;
+        Eigen::Vector3f p = point->GetWorldPos();
+        if(p.allFinite())
+            f << point->mnId << " " << p.x() << " " << p.y() << " " << p.z() << "\n";
+    }
+}
